<!-- Caret: the long-press panel, rounded all the way like Gboard's, with a soft edge for depth -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="#14777777" />
            <padding android:top="0dp" android:right="1dp" android:bottom="1dp" android:left="1dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="27dp" />
            <solid android:color="#28777777" />
            <padding android:top="0dp" android:right="1dp" android:bottom="1dp" android:left="1dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="26dp" />
            <solid android:color="#ffffff" />
        </shape>
    </item>
</layer-list>
