index f2c968d..725e4d7 100644
--- a/jni/swipe_jni.cpp
+++ b/jni/swipe_jni.cpp
@@ -4,6 +4,7 @@
 
 #include "swipe_decoder/engine.hpp"
 #include "swipe_decoder/unicode_case.hpp"
+#include "swipe_decoder/trie.hpp"
 
 #include <jni.h>
 #include <android/log.h>
@@ -204,6 +205,37 @@ Java_org_futo_ml_inference_SwipeDecoder_nativeRecognize(
     return out;
 }
 
+static std::vector<std::string> to_strings(JNIEnv* env, jobjectArray array) {
+    std::vector<std::string> out;
+    if (!array) return out;
+    jint len = env->GetArrayLength(array);
+    out.reserve(len);
+    for (jint i = 0; i < len; ++i) {
+        auto jstr = static_cast<jstring>(env->GetObjectArrayElement(array, i));
+        if (!jstr) { out.emplace_back(); continue; }
+        const char* cstr = env->GetStringUTFChars(jstr, nullptr);
+        out.emplace_back(cstr);
+        env->ReleaseStringUTFChars(jstr, cstr);
+        env->DeleteLocalRef(jstr);
+    }
+    return out;
+}
+
+// Caret: context LM scores for given words, to rank typing corrections.
+JNIEXPORT jfloatArray JNICALL
+Java_org_futo_ml_inference_SwipeDecoder_nativeScoreWords(
+    JNIEnv* env, jobject /* obj */,
+    jlong handle, jobjectArray contextArray, jobjectArray wordsArray
+) {
+    auto* engine = to_engine(handle);
+    if (!engine || !wordsArray) return nullptr;
+    auto scores = engine->score_words(to_strings(env, contextArray), to_strings(env, wordsArray));
+    if (scores.empty()) return nullptr;
+    jfloatArray out = env->NewFloatArray(static_cast<jsize>(scores.size()));
+    env->SetFloatArrayRegion(out, 0, static_cast<jsize>(scores.size()), scores.data());
+    return out;
+}
+
 JNIEXPORT jobjectArray JNICALL
 Java_org_futo_ml_inference_SwipeDecoder_nativePredictNext(
     JNIEnv* env, jobject /* obj */,
@@ -392,6 +424,43 @@ Java_org_futo_ml_inference_SwipeDecoder_nativeSetCaseMapping(
     if (to)   env->ReleaseIntArrayElements(toArray,   to,   JNI_ABORT);
 }
 
+// --- Caret additions: build the library's own trie from a .combined word list ---
+
+// Returns a Trie* (0 on failure). The letters must match the layout passed to setMode.
+JNIEXPORT jlong JNICALL
+Java_org_futo_ml_inference_SwipeDecoder_nativeLoadTrie(
+    JNIEnv* env, jclass /* clazz */, jstring path, jstring letters
+) {
+    const std::string p = jstr_or_empty(env, path);
+    const std::string l = jstr_or_empty(env, letters);
+    ParsedCombined combined;
+    if (!parse_combined_vocab(p, "f", combined)) {
+        LOGE("nativeLoadTrie: cannot read %s", p.c_str());
+        return 0;
+    }
+    Trie* trie = l.empty() ? new Trie() : new Trie(l);
+    apply_parsed_to_trie(combined, *trie);
+    LOGI("nativeLoadTrie: %zu words from %s", trie->size(), p.c_str());
+    return static_cast<jlong>(reinterpret_cast<uintptr_t>(trie));
+}
+
+// Returns the ITrie* to pass in setMode's tries array. Valid until nativeFreeTrie.
+JNIEXPORT jlong JNICALL
+Java_org_futo_ml_inference_SwipeDecoder_nativeTrieInterface(
+    JNIEnv* /* env */, jclass /* clazz */, jlong handle
+) {
+    auto* trie = reinterpret_cast<Trie*>(static_cast<uintptr_t>(handle));
+    if (!trie) return 0;
+    return static_cast<jlong>(reinterpret_cast<uintptr_t>(trie->itrie()));
+}
+
+JNIEXPORT void JNICALL
+Java_org_futo_ml_inference_SwipeDecoder_nativeFreeTrie(
+    JNIEnv* /* env */, jclass /* clazz */, jlong handle
+) {
+    delete reinterpret_cast<Trie*>(static_cast<uintptr_t>(handle));
+}
