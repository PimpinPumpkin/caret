+// --- Caret additions: build the library's own trie from a .combined word list ---
+
+// Returns a Trie* (0 on failure). The letters must match the layout passed to setMode.
+JNIEXPORT jlong JNICALL
+Java_org_futo_ml_inference_SwipeDecoder_nativeLoadTrie(
+    JNIEnv* env, jclass /* clazz */, jstring path, jstring letters
+) {
+    const std::string p = jstr_or_empty(env, path);
+    const std::string l = jstr_or_empty(env, letters);
+    ParsedCombined combined;
+    if (!parse_combined_vocab(p, "f", combined)) {
+        LOGE("nativeLoadTrie: cannot read %s", p.c_str());
+        return 0;
+    }
+    Trie* trie = l.empty() ? new Trie() : new Trie(l);
+    apply_parsed_to_trie(combined, *trie);
+    LOGI("nativeLoadTrie: %zu words from %s", trie->size(), p.c_str());
+    return static_cast<jlong>(reinterpret_cast<uintptr_t>(trie));
+}
+
+// Returns the ITrie* to pass in setMode's tries array. Valid until nativeFreeTrie.
+JNIEXPORT jlong JNICALL
+Java_org_futo_ml_inference_SwipeDecoder_nativeTrieInterface(
+    JNIEnv* /* env */, jclass /* clazz */, jlong handle
+) {
+    auto* trie = reinterpret_cast<Trie*>(static_cast<uintptr_t>(handle));
+    if (!trie) return 0;
+    return static_cast<jlong>(reinterpret_cast<uintptr_t>(trie->itrie()));
+}
+
+JNIEXPORT void JNICALL
+Java_org_futo_ml_inference_SwipeDecoder_nativeFreeTrie(
+    JNIEnv* /* env */, jclass /* clazz */, jlong handle
+) {
+    delete reinterpret_cast<Trie*>(static_cast<uintptr_t>(handle));
+}
+
